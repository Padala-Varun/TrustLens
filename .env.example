# Copy this file to .env (in this same folder) and fill in the values.

# Required - https://console.mistral.ai -> API Keys
MISTRAL_API_KEY=

# Required - https://app.tavily.com (free plan: 1000 credits/month, ~10 per analysis)
TAVILY_API_KEY=

# Optional but strongly recommended - https://github.com/settings/tokens
# Fine-grained token, "Public repositories (read-only)", no extra permissions.
# Without it GitHub allows only 60 requests/hour (about 4-5 analyses).
GITHUB_TOKEN=

# Optional - Mistral model used for the reasoning step.
# The free plan only allows the Ministral models; on a paid plan
# mistral-medium-2604 gives better reasoning.
MISTRAL_MODEL=ministral-14b-2512
